# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Signs sessions. At least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The public URL of the app, for OAuth callbacks (optional locally).
BETTER_AUTH_URL=http://localhost:3000

# Sign-in with GitHub: set both, or neither to turn it off.
# Create an OAuth app at https://github.com/settings/developers with the callback URL
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
