---
// For use inside MDX posts: <Callout title="Note">...</Callout>
interface Props {
  title?: string;
}

const { title = 'Note' } = Astro.props;
---

<aside class="not-prose my-6 rounded-lg border-l-4 border-sky-600 bg-sky-50 p-4 text-slate-800">
  <p class="font-semibold">{title}</p>
  <div class="mt-1"><slot /></div>
</aside>
