---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, lead, image, imageAlt = '' } = Astro.props;
---

<section class="mx-auto grid max-w-4xl items-center gap-8 px-4 py-12 md:grid-cols-2">
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">{title}</h1>
    {lead && <p class="mt-4 text-lg text-slate-700">{lead}</p>}
    <div class="mt-6 flex gap-4"><slot /></div>
  </div>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 960]}
        sizes="(min-width: 768px) 448px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full rounded-xl"
      />
    )
  }
</section>
