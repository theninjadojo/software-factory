---
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---

<BaseLayout title="About" description={`About ${SITE.title}.`}>
  <div class="mx-auto max-w-4xl px-4 pt-12">
    <h1 class="text-4xl font-bold tracking-tight">About</h1>
  </div>
  <Section title="What we do">
    <p class="max-w-prose text-slate-700">Tell visitors who you are and what this site is for.</p>
  </Section>
</BaseLayout>
