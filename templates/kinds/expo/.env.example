# The FastAPI backend (the -api repository). EXPO_PUBLIC_ variables are inlined into the app bundle: never put
# secrets in them. On a device, use your computer's LAN address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional: the iOS bundle identifier / Android package. Defaults to one derived in app.config.ts.
# APP_ID=com.example.app
