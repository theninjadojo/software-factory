# Where the factory keeps its files on the HOST (created by you; see README "Docker"). Mounted at the same path in the containers.
FACTORY_HOME=/srv/factory
# Group id that owns the engine socket:   stat -c %g /var/run/docker.sock
DOCKER_GID=
# Only if your engine socket is somewhere else (rootless Docker: /run/user/$UID/docker.sock)
# DOCKER_SOCK=/var/run/docker.sock

# The UI listens on this host address and port. Loopback by default; reach it with an SSH tunnel, a VPN or a TLS reverse proxy.
# FACTORY_UI_BIND=127.0.0.1
# FACTORY_UI_PORT=8787
# The worker API (only with `docker compose --profile workers up -d`). Loopback by default: use an SSH tunnel, a VPN or TLS in front of it.
# FACTORY_WORKERS_BIND=127.0.0.1
# FACTORY_WORKERS_PORT=8788
# Extra Host header values the UI accepts (comma separated), needed if you expose it on a LAN name or address:
# FACTORY_UI_ALLOWED_HOSTS=factory.lan

# Release installs: the image of this version (written by scripts/update.sh). Leave unset to build from source.
# SHIKUMI_IMAGE=ghcr.io/theninjadojo/shikumi:v0.1.0
# Where releases come from (owner/name). Only needed for a fork.
# SHIKUMI_REPO=theninjadojo/software-factory
