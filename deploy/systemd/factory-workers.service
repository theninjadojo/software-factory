[Unit]
Description=Software factory worker API (verification workers pull jobs from here)
After=factory.service

[Service]
# Only needed when [workers] enabled = true. Loopback by default: reach it from a Mac with an SSH tunnel
# (ssh -L 8788:127.0.0.1:8788 host), a VPN, or a TLS reverse proxy. Create a token per worker first:
#   python3 -m factory.ctl workers add my-mac
ExecStart=/usr/bin/python3 -m factory.workerapi --config /srv/factory/config.toml
WorkingDirectory=/srv/factory/app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
